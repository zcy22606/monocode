<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- IndieDesk: declare the UI languages so WebKit reports the system language
	     and system dialogs follow it. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>zh-Hans</string>
	</array>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>NSDesktopFolderUsageDescription</key>
	<string>MonoCode opens project folders you choose, including Desktop.</string>
	<key>NSDocumentsFolderUsageDescription</key>
	<string>MonoCode opens project folders you choose, including Documents.</string>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>MonoCode opens project folders you choose, including Downloads.</string>
</dict>
</plist>
